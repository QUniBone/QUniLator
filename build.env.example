# build.env
#
# Where ./crossbuild.sh -d puts what it built. Copy this file to build.env and
# fill it in; build.env names one person's board, so it stays out of git.
#
# Nothing here affects a plain build - only -d reads it.

# ssh destination of the board, as scp and ssh take it.
QUNILATOR_HOST=you@yourboard.local

# What is on the board:
#
#   appliance  a board flashed from the release image. The emulator is
#              /usr/bin/<name> - qbone or unibone, whichever bus the build is
#              for - and <name>.service runs it. The deploy replaces that file
#              and restarts the unit.
#
#   checkout   a board carrying a source tree, running the binary out of it.
#              The deploy replaces 10.03_app_demo/4_deploy_<suffix>/demo below
#              QUNILATOR_REMOTE_DIR.
QUNILATOR_DEPLOY_MODE=appliance

# checkout mode: the source tree on the board, relative to the login directory
# or absolute.
#QUNILATOR_REMOTE_DIR=QUniLator

# appliance mode: also send the web frontend to /usr/share/qunilator/frontend.
# It is served from disk, so this takes effect without a restart. Needs a built
# bundle - 'npm ci && npm run build' in 10.05_web/3_frontend.
#QUNILATOR_DEPLOY_FRONTEND=1

# An appliance deploy writes below /usr and restarts a unit, so the account
# QUNILATOR_HOST names needs sudo there.
