[Unit]
Description=PDP-11 Qbus device emulator
Documentation=file:/usr/share/qunilator/README.Debian
After=network.target qunilator-network.service qunilator-setup.service bbbio-set-sysconf.service
Requires=qunilator-network.service
# bbbio-set-sysconf may reboot on a first boot to apply base-image settings; if
# it does, the emulator must not have started, because a SIGTERM caught in its
# PRU startup is uninterruptible and would hang the reboot. Ordering after it
# means the emulator starts only on a boot where it has nothing left to do.

[Service]
Type=simple
Environment=QUNILATOR_DIR=/var/lib/qunilator
WorkingDirectory=/var/lib/qunilator
# /run/qunilator, where the service records the version it is running. systemd
# removes it when the unit stops, so a stale file cannot make a service that
# failed to come up look like one that did - which is what the updater's health
# check reads it for.
RuntimeDirectory=qunilator
RuntimeDirectoryMode=0755
# The PRU cores are driven through remoteproc, and pru_rproc binds them a
# moment after the modules load: on a cold boot the emulator would otherwise
# reach for PRUs that are not there yet and exit. Wait for both cores to carry
# a remoteproc device before starting.
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 100 ]; do [ -e /sys/bus/platform/devices/4a334000.pru/remoteproc ] && [ -e /sys/bus/platform/devices/4a338000.pru/remoteproc ] && exit 0; i=$((i+1)); sleep 0.2; done; echo "PRU cores did not appear under remoteproc" >&2; exit 1'

# The machine the board comes up as is the configuration designated the default
# through the web interface, applied at startup. Configurations are saved from
# the web interface and live in /var/lib/qunilator/configs. "--config <name>"
# overrides the default for bring-up and testing.
# The address width is left at the binary's own default for the bus it was
# built for: 22 bit on QBUS, 18 on the UNIBUS. "--addresswidth <n>" sets a
# QBUS board up for a 16 or 18 bit CPU.
ExecStart=/usr/bin/qbone --port 80 --webroot /usr/share/qunilator/frontend
# The bus engine runs at realtime priority and the PRU driver wants physical
# memory, so this stays privileged.
LimitRTPRIO=99
LimitMEMLOCK=infinity
# A crash here leaves nothing to look at otherwise: the emulator dies with the
# machine's whole state in it - the device set, the bus adapter's schedule, the
# thread that was mid-transfer - and none of that reaches the journal. Allow a
# core so the next one can be read (#48). The board writes it as "core" in the
# working directory below, since it carries no systemd-coredump; the cap keeps
# a mapped bus window from filling the card.
LimitCORE=2G
Restart=no
# Answering SIGTERM shuts the device set down in order, but a stop must never
# be able to hang a reboot: if the process has not exited in time - e.g. a
# SIGTERM caught mid-startup - systemd sends SIGKILL and the reboot proceeds.
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
