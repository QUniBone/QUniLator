[Unit]
Description=First-boot setup (network bridge, boot settings)
Documentation=file:/usr/share/qunilator/README.Debian
# The bridge configuration is written before networkd configures anything, so
# the first DHCP request of a board's life is the one it will keep making.
# Running after networkd meant the base image's eth0.network took a lease under
# networkd's default identity, this replaced it, and the lease was released -
# which withdraws the name from the DHCP server's DNS, taking with it the
# record for the address the board actually ends up on.
#
# eth0 is created by its driver rather than by networkd, so its MAC can be read
# here; the script waits for it to appear.
Before=network-pre.target systemd-networkd.service qunilator-network.service
Wants=network-pre.target
After=local-fs.target
# The bridge is written once, on the first boot. qunilator-setup --auto records
# this when the network is configured, and this condition stops it re-running.
ConditionPathExists=!/var/lib/qunilator/.setup-done

[Service]
Type=oneshot
RemainAfterExit=yes
# --auto reboots between passes rather than asking, so the board configures
# itself with no login. The first run writes the bridge and reboots; the next
# finds it in place, records .setup-done and hands off to the emulator.
ExecStart=/usr/sbin/qunilator-setup --auto

[Install]
WantedBy=multi-user.target
