[Unit]
Description=Network interface for the emulated Ethernet controller
Documentation=file:/usr/share/qunilator/README.Debian
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/qunilator-network start
ExecStop=/usr/sbin/qunilator-network stop

[Install]
WantedBy=multi-user.target
