#!/bin/sh
# Turn an appliance board into a development board: the source tree under
# /root, buildable there, with the example scripts of 10.03_app_demo in place
# and a shortcut to each of them in /root itself.
#
# The board an image flashes is a finished appliance - two binaries, a web root
# and a state directory - and carries no sources at all. This puts them back,
# which is what the original QUniBone board looked like: a checkout in /root,
# ./compile.sh building it there, and "sudo ./rt11v5.5_dl_shared.sh" starting a
# machine from the home directory.
#
# What it does, in order, and all of it may be run again:
#   1. installs what a build needs (compiler, headers, the TI PRU tools)
#   2. puts the repository into /root, at the tag matching the installed
#      version of the emulator
#   3. writes qunibone-platform.env for the bus this board bridges
#   4. runs qunibone-platform.sh, which merges the bus-specific examples into
#      10.03_app_demo/5_applications, links 4_deploy, makes every *.sh
#      executable and creates the shortcuts
#
# The disk images the examples mount are NOT in the repository - they are too
# large and not all of them are ours to distribute. "qunilator-fetch-images"
# brings them into /var/lib/qunilator/images, which is where the examples name
# them; the emulator expands an "<image>.gz" by itself once one is there.
#
# usage:
#   qunilator-devkit                  install everything, from the default source
#   qunilator-devkit --branch main    check out a branch or tag of your choosing
#   qunilator-devkit --url <url>      clone from somewhere else
#   qunilator-devkit --dir <path>     put the tree somewhere other than /root
#   qunilator-devkit --no-apt         install nothing, only populate the tree

set -eu

URL=https://github.com/QUniBone/QUniLator
REF=
DIR=/root
DO_APT=1

# The PRU code generation tools, pinned to the version the shipped firmware is
# built with (see crossbuild.sh). PRU_CGT_DIR is where the makefiles look:
# 10.01_base/2_src/pru*/Makefile calls $PRU_CGT/bin/clpru and $PRU_CGT/bin/hexpru.
PRU_CGT_VERSION=2.3.1
PRU_CGT_DIR=/usr/share/ti/cgt-pru
PRU_CGT_INSTALLER=ti_cgt_pru_${PRU_CGT_VERSION}_armlinuxa8hf_busybox_installer.sh
PRU_CGT_URL=https://software-dl.ti.com/codegen/esd/cgt_public_sw/PRU/${PRU_CGT_VERSION}/${PRU_CGT_INSTALLER}

# What a build of the emulator needs beyond the appliance's own dependencies:
# the C++ compiler and make, the Sun RPC library the blinkenlight API client
# speaks (glibc dropped it), X11 for the VCB01 window, and git to fetch this.
BUILD_PACKAGES="git build-essential libtirpc-dev libx11-dev"

say() { echo "qunilator-devkit: $*"; }
die() { echo "qunilator-devkit: $*" >&2; exit 1; }

usage() {
    sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
    case "$1" in
        --url)    [ $# -ge 2 ] || die "--url needs an argument";    URL=$2; shift 2 ;;
        --branch) [ $# -ge 2 ] || die "--branch needs an argument"; REF=$2; shift 2 ;;
        --dir)    [ $# -ge 2 ] || die "--dir needs an argument";    DIR=$2; shift 2 ;;
        --no-apt) DO_APT=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "qunilator-devkit: unknown option \"$1\"" >&2; usage >&2; exit 1 ;;
    esac
done

[ "$(id -u)" = 0 ] || die "run this as root: sudo qunilator-devkit"

# ---------------------------------------------------------------- identity ----
# Which board this is decides the bus the tree is built for and the names the
# binaries are installed under. Same resolution the other qunilator-* tools use:
# the emulator package that is installed.
PKG=
for p in qbone unibone; do
    if dpkg-query -W -f '${Status}' "$p" 2>/dev/null | grep -q 'install ok installed'; then
        PKG=$p
        break
    fi
done
[ -n "$PKG" ] || die "no emulator package is installed, so this is not a board"

if [ "$PKG" = unibone ]; then
    PLATFORM=UNIBUS; SUFFIX=_u
else
    PLATFORM=QBUS;   SUFFIX=_q
fi
VERSION=$(dpkg-query -W -f '${Version}' "$PKG")
say "$PKG $VERSION, a $PLATFORM board"

# ----------------------------------------------------------- prerequisites ----
install_pru_cgt() {
    # already there, in either of the two shapes the tools come in
    [ -x "$PRU_CGT_DIR/bin/clpru" ] && return 0

    # A Debian package puts the compiler in /usr/bin and the rest of the
    # toolchain under /usr/share/ti/cgt-pru; the makefiles want both under one
    # root, so that directory gets a "bin" pointing at /usr/bin.
    if command -v clpru >/dev/null 2>&1; then
        mkdir -p "$PRU_CGT_DIR"
        ln -sfn /usr/bin "$PRU_CGT_DIR/bin"
        [ -x "$PRU_CGT_DIR/bin/clpru" ] && return 0
    fi

    # ti-pru-cgt-v2.3 is what the appliance image carries and what the board's
    # own clpru has always come from; the other two are what the BeagleBoard
    # repositories have called the same thing over the years.
    for pkg in ti-pru-cgt-v2.3 ti-pru-cgt-installer ti-cgt-pru; do
        if apt-get install -y "$pkg" >/dev/null 2>&1; then
            say "installed $pkg"
            if [ ! -x "$PRU_CGT_DIR/bin/clpru" ] && command -v clpru >/dev/null 2>&1; then
                mkdir -p "$PRU_CGT_DIR"
                ln -sfn /usr/bin "$PRU_CGT_DIR/bin"
            fi
            [ -x "$PRU_CGT_DIR/bin/clpru" ] && return 0
        fi
    done

    # Nothing in this board's repositories: take the version the shipped
    # firmware was built with, straight from TI.
    say "no PRU tools in apt, fetching $PRU_CGT_INSTALLER from TI"
    tmp=$(mktemp -d)
    if ! curl --fail -sSL -o "$tmp/$PRU_CGT_INSTALLER" "$PRU_CGT_URL"; then
        rm -rf "$tmp"
        return 1
    fi
    chmod +x "$tmp/$PRU_CGT_INSTALLER"
    ( cd "$tmp" && ./"$PRU_CGT_INSTALLER" --prefix /opt/ti --mode unattended >/dev/null )
    rm -rf "$tmp"
    if [ -x "/opt/ti/ti-cgt-pru_$PRU_CGT_VERSION/bin/clpru" ]; then
        mkdir -p "$(dirname "$PRU_CGT_DIR")"
        ln -sfn "/opt/ti/ti-cgt-pru_$PRU_CGT_VERSION" "$PRU_CGT_DIR"
    fi
    [ -x "$PRU_CGT_DIR/bin/clpru" ]
}

if [ "$DO_APT" = 1 ]; then
    say "installing what a build needs ..."
    export DEBIAN_FRONTEND=noninteractive
    # Neither of these is allowed to end the run: a board carrying a repository
    # which is broken, mid-sync or simply unreachable can still have everything
    # a build needs, and the check below is what actually decides. An install
    # which did not happen shows up there, by name.
    apt-get -o DPkg::Lock::Timeout=300 -qq update \
        || say "apt-get update did not complete; using the index this board has"
    # shellcheck disable=SC2086
    apt-get -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confold \
        -qq install -y $BUILD_PACKAGES \
        || say "apt-get install did not complete; checking what is here anyway"
    install_pru_cgt || die "could not install the TI PRU code generation tools.
Install them by hand so that $PRU_CGT_DIR/bin/clpru exists - the download page is
https://www.ti.com/tool/PRU-CGT - then run this again with --no-apt."
fi

# The build needs all of these, whether this run installed them or a previous
# one did. Said now rather than fifty source files into the compile.
for tool in git gcc make; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is missing; run without --no-apt"
done
[ -x "$PRU_CGT_DIR/bin/clpru" ] && [ -x "$PRU_CGT_DIR/bin/hexpru" ] \
    || die "no PRU compiler at $PRU_CGT_DIR/bin; run without --no-apt"

# ------------------------------------------------------------------- clone ----
# /root is never empty - the shell's dotfiles live there - so this is a fetch
# into a repository created in place rather than a "git clone <url> /root",
# which refuses a directory with anything in it. Files which belong to no
# checkout are left alone.
mkdir -p "$DIR"
if [ ! -d "$DIR/.git" ]; then
    say "creating the repository in $DIR"
    git init -q "$DIR"
fi
if git -C "$DIR" remote | grep -qx origin; then
    git -C "$DIR" remote set-url origin "$URL"
else
    git -C "$DIR" remote add origin "$URL"
fi

say "fetching from $URL ..."
git -C "$DIR" fetch -q --tags origin

if [ -z "$REF" ]; then
    # The tree that matches the binaries this board runs: the package version
    # without its Debian revision is the release tag.
    tag="v${VERSION%%-*}"
    if git -C "$DIR" rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
        REF=$tag
        say "checking out $REF, the release this board runs"
    else
        git -C "$DIR" remote set-head -a origin >/dev/null 2>&1 || true
        REF=$(git -C "$DIR" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null \
            | sed 's|^origin/||')
        [ -n "$REF" ] || die "cannot tell which branch to check out; name one with --branch"
        say "no tag $tag published; checking out the $REF branch instead"
    fi
fi

# A tag is checked out detached, a branch as a branch which tracks the remote,
# so a later "git pull" in the tree does what it looks like it does.
if git -C "$DIR" rev-parse -q --verify "refs/tags/$REF" >/dev/null; then
    git -C "$DIR" checkout -f -q --detach "refs/tags/$REF"
elif git -C "$DIR" rev-parse -q --verify "refs/remotes/origin/$REF" >/dev/null; then
    git -C "$DIR" checkout -f -q -B "$REF" "origin/$REF"
else
    git -C "$DIR" checkout -f -q --detach "$REF"
fi

# ------------------------------------------------------------ personalizing ---
# The one file that says which hardware this tree is built for. It is not in the
# repository, exactly because it describes a board rather than the software.
say "writing qunibone-platform.env for $PLATFORM"
cat > "$DIR/qunibone-platform.env" <<EOF
# qunibone-platform.env
# Written by qunilator-devkit for this board: $PKG, $PLATFORM.
# Bound to specific hardware, not part of the repository.

QUNILATOR_PLATFORM_SUFFIX=$SUFFIX
QUNILATOR_PLATFORM=$PLATFORM
EOF

chmod +x "$DIR/qunibone-platform.sh"
"$DIR/qunibone-platform.sh"

tree_version=$("$DIR/packaging/version.sh" 2>/dev/null || echo "")
if [ -n "$tree_version" ] && [ "$tree_version" != "$VERSION" ]; then
    say "note: the tree is version $tree_version, the installed package is $VERSION"
fi

cat <<EOF

The development tree is in $DIR.

  cd $DIR && ./compile.sh

builds it, and installs what it built as /usr/bin/$PKG and /usr/bin/$PKG-cli,
restarting the service - which takes the emulated machine down with it. "-n"
installs without the restart, "-N" builds without installing.

The examples are in $DIR/10.03_app_demo/5_applications, with a shortcut to each
in $DIR. Each one is executable and names the emulator on its "#!" line:

  sudo $DIR/<example>.sh

The service hands the board over for the length of that session and takes it
back when it ends, so nothing has to be stopped first. The machine it rebuilds
afterwards is switched off, because what a menu session leaves behind is not
something to start a machine on.

The disk images are not in the repository. Fetch them with

  sudo qunilator-fetch-images

which brings this board's set into /var/lib/qunilator/images, where the
examples mount them from and the web interface lists them.
EOF
