# object/binary output of the demo application build
10.03_app_demo/4_deploy_q/
10.03_app_demo/4_deploy_u/
# the same, for a debug build ("crossbuild.sh -g")
10.03_app_demo/4_deploy_q_dbg/
10.03_app_demo/4_deploy_u_dbg/
# host-built CPU core test binary, objects and per-run stamps
10.06_cputest/4_deploy/
# the same, for the host tests of the shared code in 90_common
90_common/4_deploy/
# host-built VAX simulators, objects and test run output
10.07_vax/4_deploy/
# c-kermit source + binary, fetched/built by 91_3rd_party/ckermit/build.sh
91_3rd_party/ckermit/build/

# packages built by packaging/build-deb.sh
*.deb

# deploy settings of one person's board, read by crossbuild.sh -d
# (build.env.example documents them)
build.env

# staging directory and output of packaging/build-release.sh: the downloaded
# Debian base image, the package, the sample OS images and the built card image
dist/
*-dist.img
# the compressed image, its checksum, and the partly-written file a run leaves
# behind when it is interrupted
*-dist.img.*

# reMarkable pull-annotations local watermark (per-checkout)
.claude/.rm-*.json
.venv/

# simh scratch working dir (1GB disk image, driver scripts)
images/211bsd/work/

# documentation site (docs/site): dependencies and generated types. Its build
# output lands in docs/site/dist/, which the `dist/` rule above already covers.
node_modules/
.astro/
# raw scraped HTML, regenerable with docs/site/tools/scrape-retrocmp.py
docs/site/migration/raw/
# staging copies of images that now live with the manual
docs/site/migration/images/

# python bytecode cache
tools/__pycache__/

# large scanned manual PDFs (searchable .txt is committed alongside)
diagnostics/reference/*.pdf

# macro11 listings, object files and bootable disk images built from tools/*.mac
tools/*.lst
tools/*.obj
tools/*.rl02

.claude/worktrees/

# clangd compilation database, written by tools/gen-compile-commands.sh
compile_commands.json
# clangd's background index, rebuilt from the sources on demand
.cache/
