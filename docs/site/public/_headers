# Response headers for the published tree.
#
# Read by Netlify and Cloudflare Pages. NOT read by Caddy, which serves the
# current deployment at qunilator.com — there the same headers are declared as
# `header_paths` on the qunilator.com static site in netzhansa-infra
# (roles/caddy, inventory/group_vars/all/main.yml). Keep the two in step; this
# file is what a move to a static host would carry.
#
# The board fetches the catalogue itself; the permissive CORS costs nothing
# and keeps the index readable from a page too — a debugging fetch from the
# browser console, or a future client that has only a browser to work with.
/catalog/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
