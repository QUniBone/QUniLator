# clangd configuration.
#
# What clangd needs to parse this project is the include paths and defines each
# source is really compiled with, and those live in the makefiles. Run
#
#	./tools/gen-compile-commands.sh
#
# to write compile_commands.json, which asks the makefiles and records their
# answers; clangd finds it at the repository root and needs nothing else. It is
# generated rather than committed, and is regenerated after an include path
# changes or a directory of sources is added.
#
# What follows applies only to a file the database does not name - a new source
# not yet in any makefile, or a header opened on its own. It is a fallback, not
# a description of the build.
CompileFlags:
  Add:
    # The board's gcc does not deprecate sprintf/vsprintf/syscall; only a host
    # libc does. Drop that host-only noise so a file parsed without the database
    # reads as it will compile.
    - -Wno-deprecated-declarations
    # -D__linux__ steers the platform #ifdefs (rs232.hpp and the like) to the
    # POSIX branch the board compiles, rather than the Windows fallback a macOS
    # host would otherwise take.
    - -D__linux__
    - -DARM
