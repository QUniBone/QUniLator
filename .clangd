# clangd configuration for editing QBone C++ in an IDE.
#
# The build drives the real compiler through the makefiles (and the Docker
# crossbuild); a bare clangd has none of their -I paths or -D defines, so it
# reports spurious "file not found" errors for civetweb.h, logger.hpp and the
# like, which then cascade into undeclared-identifier noise. These flags give
# clangd the same view the QBUS build has, so those false diagnostics disappear.
#
# Notes:
# - Paths are relative to this file (the repo root); clangd resolves them from
#   the workspace root.
# - -D__linux__ steers the platform #ifdefs (e.g. rs232.hpp) to the POSIX branch
#   the Linux/ARM board actually compiles, rather than the Windows fallback a
#   macOS or other host would otherwise take.
# - The host toolchain's headers are used for the standard library, which is
#   enough to parse the project's own sources.
CompileFlags:
  Add:
    - -std=c++11
    # The board's gcc (and CI) do not deprecate sprintf/vsprintf/syscall; only a
    # host libc (e.g. macOS) does. Drop that host-only noise so the editor's
    # diagnostics match the actual target build.
    - -Wno-deprecated-declarations
    - -D__linux__
    - -DARM
    - -DQBUS
    - -DBLINKENLIGHT_CLIENT
    - -DDBG
    - -DWEBUI
    - -DUSE_WEBSOCKET
    - -DNO_SSL
    - -DNO_CGI
    - -I90_common/src
    - -I10.01_base/2_src/shared
    - -I10.01_base/2_src/arm
    - -I10.02_devices/2_src
    - -I10.02_devices/2_src/blinkenbone
    - -I10.04_device_exerciser/2_src
    - -I10.03_app_demo/2_src
    - -I10.05_web/2_src
    - -I91_3rd_party/civetweb
    - -I91_3rd_party/picojson

---
# The VAX host of 10.07_vax and the simh sources it builds are C, not C++, and
# they are built by 10.07_vax/2_src/makefile with a configuration of their own.
# The flags above describe the QBUS C++ build and do not apply, so this fragment
# takes them off again and gives clangd the VAX build's view instead.
If:
  PathMatch:
    - 10.07_vax/.*
    - 91_3rd_party/simh_vax/.*
CompileFlags:
  Remove:
    - -std=c++11
    - -D__linux__
    - -DARM
    - -DQBUS
    - -DBLINKENLIGHT_CLIENT
    - -DDBG
    - -DWEBUI
    - -DUSE_WEBSOCKET
  Add:
    # Headers default to Objective-C++ in clangd, which rejects -std=c99 outright
    # and then reports every type in them as unknown.
    - -xc
    - -std=c99
    - -U__STRICT_ANSI__
    - -DVM_VAX
    - -DVAX_780
    - -DUSE_INT64
    - -DUSE_ADDR64
    # Named from the repository root, as the flags above are, and again from the
    # two directories the VAX sources sit in - 10.07_vax/2_src/shim and
    # 91_3rd_party/simh_vax/* - because a clangd with no compilation database
    # resolves a relative -I against the directory of the file it is parsing. A
    # path that does not exist from where clangd stands is ignored.
    - -I91_3rd_party/simh_vax/sim
    - -I91_3rd_party/simh_vax/VAX
    - -I91_3rd_party/simh_vax/PDP11
    - -I10.07_vax/2_src/shim
    - -I../../../91_3rd_party/simh_vax/sim
    - -I../../../91_3rd_party/simh_vax/VAX
    - -I../../../91_3rd_party/simh_vax/PDP11
    - -I../../../10.07_vax/2_src/shim
    - -I../sim
    - -I../VAX
    - -I../PDP11
