# compile-bbb.env
#
# Environment variables to compile QUniLator on the BeagleBone itself.
# Used in Makefiles.

# installation root; presettable (e.g. in qunibone-platform.env)
# for installations outside $HOME, such as a git clone in ~/QUniBone
export QUNILATOR_DIR=${QUNILATOR_DIR:-$HOME}
export BBB_CC=gcc

# The TI PRU code generation tools. The makefiles call $PRU_CGT/bin/clpru and
# $PRU_CGT/bin/hexpru; the Debian package for the board installs those in
# /usr/bin and the rest of the toolchain under /usr/share/ti/cgt-pru, so that
# directory gets a "bin" pointing at /usr/bin. Only when it is missing: the
# tarball installers from TI bring their own bin/, and re-creating the link on
# every build fails noisily on a machine which has no such directory at all.
export PRU_CGT=${PRU_CGT:-/usr/share/ti/cgt-pru}
# qunilator-devkit makes this link when it installs the tools, as root; here it
# is the fallback, and a build without the rights to create it says so through
# the compiler that is then not found rather than through a failing ln.
if [ ! -x "$PRU_CGT/bin/clpru" ] && [ -x /usr/bin/clpru ] && [ -d "$PRU_CGT" ] ; then
    ln -sfn /usr/bin "$PRU_CGT/bin" 2>/dev/null
fi
