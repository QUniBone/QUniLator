# PRUSSDRV includes
PRUSS_INCLUDE_DIR = $(PRU_PACKAGE_ROOT)/include
# ARM LIBRARIES
PRUSS_DRV_LIB = $(PRU_PACKAGE_ROOT)/bin-bbb/libprussdrv.a

# Linked against the shared libraries of the distribution the appliance image
# carries, which the package names in its Depends. glibc resolves host names
# and users through name service modules it loads with dlopen(), and a static
# binary loads the ones belonging to whatever glibc the board runs rather than
# the one it was built against: on a BeagleBone running glibc 2.41, a binary
# built on 2.36 faulted with SIGFPE inside getaddrinfo().
#
# -no-pie: the prebuilt libprussdrv.a holds no position-independent code, and
# a toolchain defaulting to PIE rejects its relocations ("can not be used when
# making a shared object; recompile with -fPIC").
#
# EXTRA_LIBS: additional libraries some toolchains need
# (e.g. -ltirpc where Sun RPC is no longer part of glibc)
LDFLAGS+= -no-pie -lstdc++ -lpthread -lX11 $(PRUSS_DRV_LIB) $(EXTRA_LIBS)

# Conditional compiles shared by the ARM code and the PRU code, so both sides of
# the emulator are built for the same bus.
#
# NO_PHYSICAL_BUS builds an emulator whose QBUS is internal: the PRU keeps the
# bus latches to itself instead of driving the backplane, and reads back what it
# wrote. A board built this way runs outside a machine. Select it with
# "crossbuild.sh -n".
CC_CODE_FLAGS = -DQBUS -DBLINKENLIGHT_CLIENT
ifdef NO_PHYSICAL_BUS
	CC_CODE_FLAGS += -DNO_PHYSICAL_BUS
endif

# compiler flags and libraries
ifeq ($(MAKE_CONFIGURATION),RELEASE)
	CC_DBG_FLAGS = -O3 -Wall -Wextra -Wshadow -DDBG
else ifeq ($(MAKE_CONFIGURATION),DBG)
 	CC_DBG_FLAGS = -ggdb3 -O0 -Wall -Wextra -Wshadow -DDBG
else
	$(error Set MAKE_CONFIGURATION to RELEASE or DBG!)
endif

ifeq ($(MAKE_TARGET_ARCH),BBB)
	# cross compile on x64 for BBB
	CC=$(BBB_CC)
	OS_CCDEFS = -DARM -U__STRICT_ANSI__
	OBJDIR=$(abspath ../4_deploy_q)
else
	# local compile on BBB
	OS_CCDEFS = -DARM -U__STRICT_ANSI__
	OBJDIR=$(abspath ../4_deploy_q)
endif



