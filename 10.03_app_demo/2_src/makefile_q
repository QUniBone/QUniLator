# The version the binary reports, taken from packaging/debian/changelog - the
# same source the package's version comes from. The service publishes it on
# /api/version and writes it to /run/qunilator/version, which is what proves to
# the updater that the instance answering is the one the new package installed.
QUNILATOR_VERSION := $(shell $(QUNILATOR_ROOT)/packaging/version.sh)

